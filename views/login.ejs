<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<div class="login-shell">
  <div class="login-left">
    <strong>TokoKita</strong>
    <div><small>E-Commerce Admin Panel</small></div>

    <div class="login-hero">
      <h2>Kelola Toko Online Anda</h2>
      <p>
        Platform admin terintegrasi dengan fitur multi-kurir tracking real-time.
        Pantau pesanan, pengiriman, dan pembayaran dalam satu dashboard.
      </p>
      <ul class="feature-row">
        <li>Real-time tracking</li>
        <li>Multi-kurir support (JNE, J&T, SiCepat)</li>
        <li>Laporan lengkap</li>
      </ul>
    </div>

    <div class="login-footer">(c) 2026 TokoKita</div>
  </div>

  <div class="login-right">
    <div class="login-form-wrap">
      <h1>Masuk</h1>
      <p>Silakan masuk ke akun admin Anda.</p>

      <% if (flash.success && flash.success.length) { %>
        <div class="alert alert-success"><%= flash.success[0] %></div>
      <% } %>
      <% if (flash.error && flash.error.length) { %>
        <div class="alert alert-error"><%= flash.error[0] %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="form-group">
          <label for="email">Email</label>
          <input
            id="email"
            class="form-control"
            type="email"
            name="email"
            value="admin@tokokita.com"
            required
            autofocus>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            id="password"
            class="form-control"
            type="password"
            name="password"
            required>
        </div>

        <button type="submit" class="btn btn-primary">Masuk</button>
      </form>
    </div>
  </div>
</div>

</body>
</html>
