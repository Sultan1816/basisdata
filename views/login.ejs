<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/api.js"></script>
</head>
<body>

<div class="login-shell">
  <div class="login-left">
    <strong>TokoKita</strong>
    <div><small>E-Commerce Admin Panel</small></div>

    <div class="login-hero">
      <h2>Kelola Toko Online Anda</h2>
      <p>
        Platform admin terintegrasi dengan fitur multi-kurir tracking real-time.
        Pantau pesanan, pengiriman, dan pembayaran dalam satu dashboard.
      </p>
      <ul class="feature-row">
        <li>Real-time tracking</li>
        <li>Multi-kurir support (JNE, J&T, SiCepat)</li>
        <li>Laporan lengkap</li>
      </ul>
    </div>

    <div class="login-footer">(c) 2026 TokoKita</div>
  </div>

  <div class="login-right">
    <div class="login-form-wrap">
      <h1>Masuk</h1>
      <p>Silakan masuk ke akun admin Anda.</p>

      <div id="flash"></div>

      <form id="loginForm">
        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" class="form-control" type="email" name="email"
                 value="admin@tokokita.com" required autofocus>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" class="form-control" type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary">Masuk</button>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email    = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    try {
      await API.post('/api/auth/login', { email, password });
      location.href = '/';
    } catch (err) {
      showError(err.message);
    }
  });
</script>

</body>
</html>
