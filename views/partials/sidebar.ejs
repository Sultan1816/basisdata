<aside class="sidebar">
  <div class="sidebar-logo">
    <strong>TokoKita</strong>
    <div><small>Admin Panel</small></div>
  </div>

  <% if (currentUser) { %>
    <div class="sidebar-user">
      <%= currentUser.nama %><br>
      <small><%= currentUser.role %></small>
    </div>
  <% } %>

  <nav class="sidebar-nav">
    <div class="nav-label">Menu Utama</div>
    <a href="/"            class="nav-item <%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
    <a href="/produk"      class="nav-item <%= currentPath.startsWith('/produk')     ? 'active' : '' %>">Produk</a>
    <a href="/pesanan"     class="nav-item <%= currentPath.startsWith('/pesanan')    ? 'active' : '' %>">Pesanan</a>
    <a href="/pengiriman"  class="nav-item <%= currentPath.startsWith('/pengiriman') ? 'active' : '' %>">Pengiriman</a>
    <a href="/pembayaran"  class="nav-item <%= currentPath.startsWith('/pembayaran') ? 'active' : '' %>">Pembayaran</a>
    <a href="/pelanggan"   class="nav-item <%= currentPath.startsWith('/pelanggan')  ? 'active' : '' %>">Pelanggan</a>
  </nav>

  <div class="sidebar-footer">
    <button type="button" class="link-btn" id="btnLogout">Keluar</button>
  </div>
</aside>

<script>
  document.getElementById('btnLogout')?.addEventListener('click', async () => {
    try { await API.post('/api/auth/logout'); } catch (_) {}
    location.href = '/login';
  });
</script>
