<form method="GET" action="/pelanggan" class="filter-bar">
  <label>
    Cari:
    <input type="text" name="q" value="<%= filters.q %>" placeholder="Nama, email, no. HP...">
  </label>
  <label>
    Status:
    <select name="status" onchange="this.form.submit()">
      <option value="">Semua</option>
      <option value="aktif"    <%= filters.status === 'aktif'    ? 'selected' : '' %>>Aktif</option>
      <option value="nonaktif" <%= filters.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
      <option value="diblokir" <%= filters.status === 'diblokir' ? 'selected' : '' %>>Diblokir</option>
    </select>
  </label>
  <button type="submit" class="btn">Filter</button>
</form>

<table class="table">
  <thead>
    <tr>
      <th>Nama</th>
      <th>Email</th>
      <th>No. HP</th>
      <th>Tanggal Daftar</th>
      <th>Total Pesanan</th>
      <th>Total Belanja</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% if (!pelanggan.length) { %>
      <tr><td colspan="7">Tidak ada pelanggan.</td></tr>
    <% } %>
    <% const statusMap = {
         aktif:    'Aktif',
         nonaktif: 'Nonaktif',
         diblokir: 'Diblokir'
       }; %>
    <% pelanggan.forEach(p => { %>
      <tr>
        <td><%= p.nama %></td>
        <td><%= p.email %></td>
        <td><%= p.no_hp %></td>
        <td><%= formatTanggal(p.tanggal_daftar) %></td>
        <td><%= p.total_pesanan %></td>
        <td><%= rupiah(p.total_belanja) %></td>
        <td><%= statusMap[p.status_akun] || p.status_akun %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
