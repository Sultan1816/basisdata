<h3>Lacak Paket</h3>
<form method="GET" action="/pengiriman" class="filter-bar">
  <label>
    Kurir:
    <select name="kurir">
      <option value="">Semua</option>
      <% kurirStats.forEach(k => { %>
        <option value="<%= k.kode_kurir %>" <%= filters.kurir === k.kode_kurir ? 'selected' : '' %>><%= k.kode_kurir %></option>
      <% }) %>
    </select>
  </label>
  <label>
    No. Resi:
    <input type="text" name="q" value="<%= filters.q %>" placeholder="contoh: JNE00123456789">
  </label>
  <button type="submit" class="btn">Cari</button>
</form>

<h3>Ringkasan per Kurir</h3>
<table class="table">
  <thead>
    <tr>
      <th>Kurir</th>
      <th>Total Paket</th>
      <th>Terkirim</th>
      <th>Dalam Perjalanan</th>
    </tr>
  </thead>
  <tbody>
    <% kurirStats.forEach(k => { %>
      <tr>
        <td><%= k.nama_kurir %> (<%= k.kode_kurir %>)</td>
        <td><%= k.total %></td>
        <td><%= k.terkirim %></td>
        <td><%= k.perjalanan %></td>
      </tr>
    <% }) %>
    <% const tot = kurirStats.reduce((a, k) => ({
         total:      a.total      + k.total,
         terkirim:   a.terkirim   + k.terkirim,
         perjalanan: a.perjalanan + k.perjalanan
       }), { total: 0, terkirim: 0, perjalanan: 0 }); %>
    <tr>
      <td><strong>Total Aktif</strong></td>
      <td><strong><%= tot.total %></strong></td>
      <td><strong><%= tot.terkirim %></strong></td>
      <td><strong><%= tot.perjalanan %></strong></td>
    </tr>
  </tbody>
</table>

<% if (tracking) { %>
  <h3>Detail Tracking</h3>
  <ul class="kv-list">
    <li>Kurir: <%= tracking.nama_kurir %> (<%= tracking.kode_kurir %>) <%= tracking.layanan || '' %></li>
    <li>No. Resi: <strong><%= tracking.no_resi %></strong></li>
    <li>Status: <strong><%= statusLabel(STATUS_KIRIM, tracking.status_kirim) %></strong></li>
    <li>Tanggal Kirim: <%= formatTanggal(tracking.tanggal_kirim) %></li>
    <li>Estimasi Tiba: <%= formatTanggal(tracking.estimasi_tiba) %></li>
    <li>Ongkos Kirim: <%= rupiah(tracking.ongkos_kirim) %></li>
    <li>Berat Paket: <%= tracking.total_berat_gram %> gram</li>
  </ul>

  <h3>Riwayat Perjalanan Paket</h3>
  <% if (!riwayat.length) { %>
    <p>Belum ada riwayat tracking.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Waktu</th>
          <th>Lokasi</th>
          <th>Keterangan</th>
        </tr>
      </thead>
      <tbody>
        <% riwayat.forEach(rs => { %>
          <tr>
            <td><%= formatTanggalJam(rs.waktu_update) %></td>
            <td><%= rs.lokasi || '-' %></td>
            <td><%= rs.deskripsi %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <h3>Alamat Penerima</h3>
  <ul class="kv-list">
    <li>Penerima: <%= pesanan.penerima %></li>
    <li>Telepon: <%= pesanan.no_hp_penerima %></li>
    <li>Alamat: <%= pesanan.alamat_lengkap %>, <%= pesanan.kota %>, <%= pesanan.provinsi %> <%= pesanan.kode_pos %></li>
  </ul>

  <h3>Ringkasan Pesanan #TK-<%= String(pesanan.id_pesanan).padStart(4, '0') %></h3>
  <table class="table">
    <thead>
      <tr>
        <th>Produk</th>
        <th>Jumlah</th>
        <th>Harga Satuan</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(it => { %>
        <tr>
          <td><%= it.nama_produk %></td>
          <td><%= it.jumlah %></td>
          <td><%= rupiah(it.harga_satuan) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <ul class="kv-list">
    <li>Subtotal Produk: <%= rupiah(pesanan.total_harga) %></li>
    <li>Ongkos Kirim: <%= rupiah(pesanan.ongkos_kirim) %></li>
    <li>Diskon: - <%= rupiah(pesanan.diskon) %></li>
    <li>Total Bayar: <strong><%= rupiah(pesanan.total_tagihan) %></strong></li>
  </ul>

  <% if (bayar) { %>
    <p>
      Pembayaran <strong><%= statusLabel(STATUS_BAYAR, bayar.status_bayar) %></strong>
      via <%= metodeLabel(bayar.metode, bayar.nama_penyedia) %><% if (bayar.tanggal_bayar) { %>
      pada <%= formatTanggalJam(bayar.tanggal_bayar) %><% } %>.
    </p>
  <% } %>

  <p><a href="/pesanan/<%= pesanan.id_pesanan %>" class="btn">Buka Pesanan</a></p>
<% } else { %>
  <p>Tidak ada pengiriman aktif. Masukkan nomor resi di atas untuk melacak paket.</p>
<% } %>
