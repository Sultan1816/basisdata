<h2>Pesanan #TK-<%= String(pesanan.id_pesanan).padStart(4, '0') %></h2>
<p class="text-muted">
  <%= formatTanggalJam(pesanan.tanggal_pesan) %>
  - Status: <strong><%= STATUS_PESANAN[pesanan.status_pesanan] || pesanan.status_pesanan %></strong>
</p>

<h3>Produk Dipesan</h3>
<table class="table">
  <thead>
    <tr>
      <th>Produk</th>
      <th>Jumlah</th>
      <th>Harga Satuan</th>
      <th>Subtotal</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(it => { %>
      <tr>
        <td><%= it.nama_produk %></td>
        <td><%= it.jumlah %></td>
        <td><%= rupiah(it.harga_satuan) %></td>
        <td><%= rupiah(it.subtotal) %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<ul class="kv-list">
  <li>Subtotal Produk: <strong><%= rupiah(pesanan.total_harga) %></strong></li>
  <li>Ongkos Kirim: <strong><%= rupiah(pesanan.ongkos_kirim) %></strong></li>
  <li>Diskon: <strong>- <%= rupiah(pesanan.diskon) %></strong></li>
  <li>Total Tagihan: <strong><%= rupiah(pesanan.total_tagihan) %></strong></li>
</ul>

<h3>Alamat Penerima</h3>
<ul class="kv-list">
  <li>Label: <%= pesanan.label %></li>
  <li>Penerima: <%= pesanan.penerima %></li>
  <li>Telepon: <%= pesanan.no_hp_penerima %></li>
  <li>Alamat: <%= pesanan.alamat_lengkap %>, <%= pesanan.kota %>, <%= pesanan.provinsi %> <%= pesanan.kode_pos %></li>
</ul>

<% if (bayar) { %>
  <h3>Pembayaran</h3>
  <ul class="kv-list">
    <li>Metode: <%= metodeLabel(bayar.metode, bayar.nama_penyedia) %></li>
    <li>Jumlah Bayar: <%= rupiah(bayar.jumlah_bayar) %></li>
    <li>Tanggal: <%= bayar.tanggal_bayar ? formatTanggalJam(bayar.tanggal_bayar) : '-' %></li>
    <li>Status: <%= STATUS_BAYAR[bayar.status_bayar] || bayar.status_bayar %></li>
  </ul>
<% } %>

<% if (kirim) { %>
  <h3>Pengiriman</h3>
  <ul class="kv-list">
    <li>Kurir: <%= kirim.kode_kurir %> <%= kirim.layanan || '' %></li>
    <li>No. Resi: <%= kirim.no_resi %></li>
    <li>Status: <%= STATUS_KIRIM[kirim.status_kirim] || kirim.status_kirim %></li>
  </ul>
  <p><a href="/pengiriman?q=<%= kirim.no_resi %>">Lacak paket</a></p>
<% } %>

<h3>Ubah Status Pesanan</h3>
<form method="POST" action="/pesanan/<%= pesanan.id_pesanan %>/status">
  <select name="status" class="form-control">
    <% Object.entries(STATUS_PESANAN).forEach(([key, label]) => { %>
      <option value="<%= key %>" <%= pesanan.status_pesanan === key ? 'selected' : '' %>><%= label %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-primary">Update Status</button>
  <a href="/pesanan" class="btn">Kembali</a>
</form>
