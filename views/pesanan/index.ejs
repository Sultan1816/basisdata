<% const tabs = [
  { key: 'semua',          label: 'Semua' },
  { key: 'menunggu_bayar', label: 'Menunggu Bayar' },
  { key: 'diproses',       label: 'Diproses' },
  { key: 'dikirim',        label: 'Dikirim' },
  { key: 'selesai',        label: 'Selesai' },
  { key: 'dibatalkan',     label: 'Dibatalkan' }
]; %>

<p class="tabs">
  <% tabs.forEach((t, i) => { %>
    <% if (i > 0) { %> | <% } %>
    <a
      href="/pesanan<%= t.key === 'semua' ? '' : `?status=${t.key}` %>"
      class="tab <%= filters.status === t.key ? 'active' : '' %>">
      <%= t.label %> (<%= Number(counts[t.key] || 0).toLocaleString('id-ID') %>)
    </a>
  <% }) %>
</p>

<form method="GET" action="/pesanan">
  <input type="hidden" name="status" value="<%= filters.status %>">
  <div class="filter-bar">
    <label>
      Cari:
      <input type="text" name="q" value="<%= filters.q %>" placeholder="ID atau nama pelanggan...">
    </label>
    <button type="submit" class="btn">Filter</button>
  </div>
</form>

<table class="table">
  <thead>
    <tr>
      <th>ID Pesanan</th>
      <th>Pelanggan</th>
      <th>Tanggal</th>
      <th>Total</th>
      <th>Pembayaran</th>
      <th>Kurir</th>
      <th>Status</th>
      <th>Aksi</th>
    </tr>
  </thead>
  <tbody>
    <% if (!pesanan.length) { %>
      <tr><td colspan="8">Tidak ada pesanan untuk filter ini.</td></tr>
    <% } %>
    <% pesanan.forEach(o => { %>
      <tr>
        <td>#TK-<%= String(o.id_pesanan).padStart(4, '0') %></td>
        <td>
          <%= o.pelanggan_nama %><br>
          <small><%= o.pelanggan_email %></small>
        </td>
        <td><%= formatTanggal(o.tanggal_pesan) %></td>
        <td><%= rupiah(o.total_tagihan) %></td>
        <td>
          <% if (o.bayar_metode) { %>
            <%= metodeLabel(o.bayar_metode, o.bayar_penyedia) %><br>
            <small><%= statusLabel(STATUS_BAYAR, o.status_bayar) %></small>
          <% } else { %>
            -
          <% } %>
        </td>
        <td><%= o.kode_kurir || '-' %></td>
        <td><%= statusLabel(STATUS_PESANAN, o.status_pesanan) %></td>
        <td><a href="/pesanan/<%= o.id_pesanan %>">Lihat</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<p class="text-muted">Menampilkan <%= pesanan.length %> dari <%= counts.semua %> pesanan.</p>
