<div class="card card-pad" style="max-width: 720px;">
  <h2 class="mt-0 mb-4"><%= produk ? 'Edit Produk' : 'Tambah Produk Baru' %></h2>

  <form method="POST" action="<%= produk ? `/produk/${produk.id_produk}/edit` : '/produk/baru' %>">
    <div class="form-group">
      <label>Nama Produk</label>
      <input type="text" name="nama_produk" class="form-control" required value="<%= produk ? produk.nama_produk : '' %>">
    </div>

    <div class="grid-2" style="grid-template-columns: 1fr 1fr; gap: 16px;">
      <div class="form-group">
        <label>Kategori</label>
        <select name="id_kategori" class="form-control" required>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k.id_kategori %>" <%= produk && produk.id_kategori === k.id_kategori ? 'selected' : '' %>><%= k.nama_kategori %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Status</label>
        <select name="is_active" class="form-control">
          <option value="1" <%= !produk || produk.is_active ? 'selected' : '' %>>Aktif</option>
          <option value="0" <%= produk && !produk.is_active ? 'selected' : '' %>>Nonaktif</option>
        </select>
      </div>
    </div>

    <div class="grid-2" style="grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
      <div class="form-group">
        <label>Harga (Rp)</label>
        <input type="number" name="harga" min="0" step="100" class="form-control" required value="<%= produk ? produk.harga : '' %>">
      </div>
      <div class="form-group">
        <label>Stok</label>
        <input type="number" name="stok" min="0" class="form-control" required value="<%= produk ? produk.stok : 0 %>">
      </div>
      <div class="form-group">
        <label>Berat (gram)</label>
        <input type="number" name="berat_gram" min="0" class="form-control" value="<%= produk ? produk.berat_gram : 0 %>">
      </div>
    </div>

    <div class="form-group">
      <label>Deskripsi</label>
      <textarea name="deskripsi" class="form-control" rows="4" placeholder="Deskripsi produk (opsional)"><%= produk ? produk.deskripsi || '' : '' %></textarea>
    </div>

    <div class="flex gap-2 mt-4">
      <button type="submit" class="btn btn-primary"><%= produk ? 'Simpan Perubahan' : 'Tambah Produk' %></button>
      <a href="/produk" class="btn btn-outline">Batal</a>
    </div>
  </form>
</div>
