<div class="card card-pad form-card">
  <h2 class="mt-0 mb-4"><%= produk ? 'Edit Produk' : 'Tambah Produk Baru' %></h2>

  <form method="POST" action="<%= produk ? `/produk/${produk.id_produk}/edit` : '/produk/baru' %>">
    <div class="form-group">
      <label for="nama_produk">Nama Produk</label>
      <input
        id="nama_produk"
        type="text"
        name="nama_produk"
        class="form-control"
        required
        value="<%= produk ? produk.nama_produk : '' %>">
    </div>

    <div class="form-row form-row-2">
      <div class="form-group">
        <label for="id_kategori">Kategori</label>
        <select id="id_kategori" name="id_kategori" class="form-control" required>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k.id_kategori %>" <%= produk && produk.id_kategori === k.id_kategori ? 'selected' : '' %>>
              <%= k.nama_kategori %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="is_active">Status</label>
        <select id="is_active" name="is_active" class="form-control">
          <option value="1" <%= !produk || produk.is_active ? 'selected' : '' %>>Aktif</option>
          <option value="0" <%= produk && !produk.is_active ? 'selected' : '' %>>Nonaktif</option>
        </select>
      </div>
    </div>

    <div class="form-row form-row-3">
      <div class="form-group">
        <label for="harga">Harga (Rp)</label>
        <input
          id="harga"
          type="number"
          name="harga"
          min="0"
          step="100"
          class="form-control"
          required
          value="<%= produk ? produk.harga : '' %>">
      </div>
      <div class="form-group">
        <label for="stok">Stok</label>
        <input
          id="stok"
          type="number"
          name="stok"
          min="0"
          class="form-control"
          required
          value="<%= produk ? produk.stok : 0 %>">
      </div>
      <div class="form-group">
        <label for="berat_gram">Berat (gram)</label>
        <input
          id="berat_gram"
          type="number"
          name="berat_gram"
          min="0"
          class="form-control"
          value="<%= produk ? produk.berat_gram : 0 %>">
      </div>
    </div>

    <div class="form-group">
      <label for="deskripsi">Deskripsi</label>
      <textarea
        id="deskripsi"
        name="deskripsi"
        class="form-control"
        rows="4"
        placeholder="Deskripsi produk (opsional)"><%= produk ? produk.deskripsi || '' : '' %></textarea>
    </div>

    <div class="form-actions-row">
      <button type="submit" class="btn btn-primary"><%= produk ? 'Simpan Perubahan' : 'Tambah Produk' %></button>
      <a href="/produk" class="btn">Batal</a>
    </div>
  </form>
</div>
