<h3>Ringkasan Produk</h3>
<ul class="kv-list">
  <li>Total Produk: <strong><%= counts.total_produk %></strong></li>
  <li>Kategori Aktif: <strong><%= counts.kategori_aktif %></strong></li>
  <li>Stok Rendah: <strong><%= counts.stok_rendah %></strong></li>
  <li>Stok Habis: <strong><%= counts.stok_habis %></strong></li>
</ul>

<form method="GET" action="/produk">
  <div class="filter-bar">
    <label>
      Kategori:
      <select name="kategori" onchange="this.form.submit()">
        <option value="">Semua (<%= totalProduk %>)</option>
        <% kategoriList.forEach(k => { %>
          <option value="<%= k.id_kategori %>" <%= String(filters.kategori) === String(k.id_kategori) ? 'selected' : '' %>>
            <%= k.nama_kategori %> (<%= k.total %>)
          </option>
        <% }) %>
      </select>
    </label>

    <label>
      Stok:
      <select name="stok" onchange="this.form.submit()">
        <option value="">Semua</option>
        <option value="tersedia" <%= filters.stok === 'tersedia' ? 'selected' : '' %>>Tersedia</option>
        <option value="rendah"   <%= filters.stok === 'rendah'   ? 'selected' : '' %>>Stok Rendah</option>
        <option value="habis"    <%= filters.stok === 'habis'    ? 'selected' : '' %>>Habis</option>
      </select>
    </label>

    <label>
      Urutkan:
      <select name="sort" onchange="this.form.submit()">
        <option value="">Default</option>
        <option value="nama_asc"    <%= filters.sort === 'nama_asc'    ? 'selected' : '' %>>Nama A-Z</option>
        <option value="termurah"    <%= filters.sort === 'termurah'    ? 'selected' : '' %>>Harga Termurah</option>
        <option value="termahal"    <%= filters.sort === 'termahal'    ? 'selected' : '' %>>Harga Termahal</option>
        <option value="stok_rendah" <%= filters.sort === 'stok_rendah' ? 'selected' : '' %>>Stok Rendah</option>
      </select>
    </label>

    <label>
      Cari:
      <input type="text" name="q" value="<%= filters.q %>" placeholder="Nama produk...">
    </label>

    <button type="submit" class="btn">Terapkan</button>
    <a href="/produk/baru" class="btn btn-primary">Tambah Produk</a>
  </div>
</form>

<table class="table">
  <thead>
    <tr>
      <th>Nama Produk</th>
      <th>Kategori</th>
      <th>Harga</th>
      <th>Stok</th>
      <th>Berat</th>
      <th>Status</th>
      <th>Aksi</th>
    </tr>
  </thead>
  <tbody>
    <% if (!products.length) { %>
      <tr><td colspan="7">Tidak ada produk.</td></tr>
    <% } %>
    <% products.forEach(p => {
      let stokLabel = 'Tersedia';
      if (p.stok === 0)        stokLabel = 'Habis';
      else if (p.stok <= 10)   stokLabel = 'Stok Rendah';
    %>
      <tr>
        <td><%= p.nama_produk %></td>
        <td><%= p.nama_kategori %></td>
        <td><%= rupiah(p.harga) %></td>
        <td><%= p.stok %> unit</td>
        <td><%= p.berat_gram %> g</td>
        <td><%= stokLabel %></td>
        <td>
          <a href="/produk/<%= p.id_produk %>/edit">Edit</a>
          |
          <form method="POST" action="/produk/<%= p.id_produk %>/hapus" class="inline-form" onsubmit="return confirm('Hapus produk ini?')">
            <button type="submit" class="link-btn">Hapus</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<p class="text-muted">Menampilkan <%= products.length %> dari <%= totalProduk %> produk.</p>
